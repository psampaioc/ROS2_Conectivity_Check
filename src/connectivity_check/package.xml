<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>connectivity_check</name>
  <version>0.1.0</version>
  <description>Minimal connectivity check: RSS + ping</description>
  <maintainer email="pedro@example.com">Pedro Sampaio</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>

  <build_depend>libnl-3-dev</build_depend>
  <build_depend>libnl-genl-3-dev</build_depend>

  <exec_depend>libnl-3-200</exec_depend>
  <exec_depend>libnl-genl-3-200</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>